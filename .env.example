# Copie para .env apenas se quiser sobrescrever os padrões. Nunca versione o .env.
TRANSPORT=stdio
PORT=3000
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1
HTTP_TIMEOUT_MS=5000
CACHE_TTL_MS=600000
PNCP_PAGE_SIZE=50
MATCH_MIN_SCORE=0.2
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60
# Hosts aceitos no modo http (proteção contra DNS rebinding), separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
# Modo demonstração: usa as fixtures de test/fixtures em vez das APIs públicas
DEMO_MODE=false
